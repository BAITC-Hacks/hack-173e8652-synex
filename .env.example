CORS_ORIGINS=http://127.0.0.1:8501,http://localhost:8501
DATA_DIR=./data
OUT_DIR=./out
ARTIFACTS_DIR=./artifacts
AGENTIC_AUTO_MONITOR_ENABLED=true
AGENTIC_AUTO_MONITOR_CADENCE_SECONDS=2
